# Base de datos (usada por docker-compose y por el backend)
# Nota: se usa el puerto 5433 en el host para no chocar con otro Postgres/TimescaleDB
# que ya esté corriendo en el 5432 de tu máquina. El contenedor sigue escuchando
# internamente en el 5432 de siempre.
DB_HOST=localhost
DB_PORT=5433
DB_USER=praxislink
DB_PASSWORD=praxislink
DB_NAME=praxislink
