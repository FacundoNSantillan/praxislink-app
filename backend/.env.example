# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (debe coincidir con el docker-compose de la raíz del proyecto)
# Puerto 5433 en el host para no chocar con otro Postgres local en el 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=praxislink
DB_PASSWORD=praxislink
DB_NAME=praxislink

# Autenticación
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Archivos subidos (fotos de perfil, logos, CVs en PDF)
UPLOADS_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=10
